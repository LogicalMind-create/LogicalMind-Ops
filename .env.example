# ─── Telegram ───────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# Group chat IDs are NEGATIVE numbers (e.g., -1001234567890)
# To find it: add @getidsbot to your Telegram group, it will reply with the ID
TELEGRAM_CHAT_ID=-1001234567890
TELEGRAM_WEBHOOK_SECRET=change-this-telegram-webhook-secret

# ─── App URL (for Telegram webhook registration) ─────────────────────────────
APP_URL=https://logicalmind-ops.onrender.com

# ─── Shiprocket (Phase 2) ───────────────────────────────────────────────────
SHIPROCKET_EMAIL=your-shiprocket-email
SHIPROCKET_PASSWORD=your-shiprocket-password
